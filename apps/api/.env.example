# Local development settings. No secrets are required by the API foundation.
APP_NAME=VaultLine Verify API
ENVIRONMENT=development
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=vaultline_verify
DATABASE_USER=vaultline_app
DATABASE_PASSWORD=replace-with-a-local-development-password

# Absolute private evidence directory; default is repository .local/evidence
# EVIDENCE_STORAGE_DIR=/absolute/private/path
MAX_UPLOAD_BYTES=10485760

# Absolute Decimal tolerances; zero means exact comparison. No currency conversion.
VERIFICATION_AMOUNT_TOLERANCE=0
VERIFICATION_QUANTITY_TOLERANCE=0
VERIFICATION_PRICE_TOLERANCE=0

# Meta key and evidence-sharing approval are PROCESS environment variables only.
# Do not commit a real key or expose either setting through NEXT_PUBLIC_*.
# export MODEL_API_KEY=<inject-from-secret-store>
# export AI_EVIDENCE_SHARING_APPROVED=true  # only after data-handling approval
# Default Meta model: muse-spark-1.3; https://api.meta.ai/v1
